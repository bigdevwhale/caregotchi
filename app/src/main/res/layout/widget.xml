<?xml version="1.0" encoding="utf-8"?>
<!-- The pet with its name and state on top, the five buttons across the whole width below; both fill the widget's height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pet"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:maxWidth="96dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3B2E26"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7A6656"
                android:textSize="13sp"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/eat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn" android:src="@drawable/icon_eat" android:scaleType="fitCenter" android:padding="8dp" android:layout_marginEnd="4dp" android:contentDescription="@string/w_eat" />
        <ImageButton android:id="@+id/water" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn" android:src="@drawable/icon_water" android:scaleType="fitCenter" android:padding="8dp" android:layout_marginEnd="4dp" android:contentDescription="@string/w_water" />
        <ImageButton android:id="@+id/pill" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn" android:src="@drawable/icon_pill" android:scaleType="fitCenter" android:padding="8dp" android:layout_marginEnd="4dp" android:contentDescription="@string/w_pill" />
        <ImageButton android:id="@+id/sleep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn" android:src="@drawable/icon_sleep" android:scaleType="fitCenter" android:padding="8dp" android:layout_marginEnd="4dp" android:contentDescription="@string/w_sleep" />
        <ImageButton android:id="@+id/bad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn_bad" android:src="@drawable/icon_heart" android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="@string/w_bad" />
    </LinearLayout>
</LinearLayout>
